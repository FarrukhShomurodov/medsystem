{
    "name": "farrukhshomurodov/medsystem",
    "type": "project",
    "description": "Hospital information system: patients and inpatient cards, appointments and staff schedules, prescriptions with drug-interaction checks, pharmacy and warehouse stock, scored medical documents, cashier.",
    "keywords": [
        "laravel",
        "healthcare",
        "hospital",
        "his",
        "emr",
        "pharmacy",
        "inventory"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "maatwebsite/excel": "^4.0",
        "spatie/laravel-permission": "^8.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.3",
        "laravel/pint": "^1.32",
        "laravel/telescope": "^5.28",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@composer install --no-interaction",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi",
            "@php artisan storage:link --ansi",
            "@php artisan migrate --seed --ansi",
            "npm ci --no-audit --no-fund",
            "npm run build"
        ],
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse --memory-limit=2G",
        "refactor": "rector process --dry-run",
        "refactor:fix": "rector process",
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "pest"
        ],
        "test:coverage": [
            "@php artisan config:clear --ansi @no_additional_args",
            "pest --coverage"
        ],
        "ci": [
            "@lint",
            "@analyse",
            "@refactor",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
