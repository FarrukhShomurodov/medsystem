APP_NAME=MedSystem
APP_ENV=local
APP_KEY=
# Development only. Production must run with APP_DEBUG=false: debug pages
# expose stack traces, queries and environment values.
APP_DEBUG=true
APP_TIMEZONE=Asia/Tashkent
# compose.yaml serves the app on APP_PORT (8080); `php artisan serve` uses 8000.
APP_URL=http://localhost:8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Defaults match compose.yaml; inside the stack DB_HOST is overridden to "db".
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=medsystem
DB_USERNAME=medsystem
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true wherever the app is served over HTTPS: the cookie is then never sent over plain HTTP.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@medsystem.test"
MAIL_FROM_NAME="${APP_NAME}"

# Telescope is a dev dependency and only boots when APP_ENV=local.
TELESCOPE_ENABLED=false

# Main administrator created by `php artisan db:seed` (config/medsystem.php).
ADMIN_EMAIL=admin@medsystem.test
ADMIN_PASSWORD=password

# Host ports published by compose.yaml, on 127.0.0.1 only. FORWARD_HOST_IP=0.0.0.0 opens them to
# the network (to try the app from another device): change DB_PASSWORD and the demo passwords first.
# FORWARD_HOST_IP=127.0.0.1
# APP_PORT=8080
# FORWARD_DB_PORT=54320
# The Vite dev server (npm run dev, or `docker compose --profile assets up vite`).
# VITE_PORT=5173
